# horizOn Simple Server Configuration

# API Key - clients must send this in X-API-Key header
API_KEY=change-me-to-a-secure-key

# Database Driver: sqlite or mysql
DB_DRIVER=sqlite

# SQLite settings (only used when DB_DRIVER=sqlite)
DB_PATH=./data/horizon.db

# MySQL settings (only used when DB_DRIVER=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=horizon
DB_USER=root
DB_PASS=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_SECOND=10

# Operator quotas. Lowering these never removes stored balances or replay guards.
# Value definitions have a 256 lifetime-key binary format bound. Other defaults are not hard caps.
PLAYER_VALUES_DEFINITIONS=64
PLAYER_VALUES_OFFERS=1000
PLAYER_VALUES_RECEIPTS=50

# Apple Sign-In (optional, single-tenant)
# Leave disabled unless you have an Apple Developer account and have
# configured a Services ID (Web) and/or a Bundle ID (iOS). See the README
# section "Apple Sign-In Self-Hosted Setup" for step-by-step instructions.
APPLE_SIGN_IN_ENABLED=false
APPLE_TEAM_ID=
# Services ID — used as the JWT `aud` for web logins (e.g. com.your-domain.web)
APPLE_SERVICE_ID=
# Bundle ID — used as the JWT `aud` for native iOS logins (e.g. com.your-company.app)
APPLE_BUNDLE_ID=

# Operator CLI configuration body size in bytes; existing default retained, adjustable for gift payloads.
GIFT_CODES_CONFIG_BYTES=16384

# Items operator defaults. Stable template identity format supports at most65536 lifetime slots.
ITEMS_CATALOG=5000
ITEMS_INVENTORY=150
ITEMS_LEGACY_RECEIPTS=50

# Marketplace operator policy (positive Int32); nominal Enterprise defaults are not maximums.
# LEGACY_RECEIPTS is advertised for compatibility; new receipts live only on their listing.
MARKETPLACE_OPEN_LISTINGS=25
MARKETPLACE_RETAINED_LISTINGS=10000
MARKETPLACE_LEGACY_RECEIPTS=100
MARKETPLACE_HISTORY=100
MARKETPLACE_WRITES_PER_MINUTE=120

# Matches operator policy;0 retained/retention disables completed detail history.
# STATE_BYTES is bounded by the existing portable MySQL BLOB frame65535, not its8192 default.
MATCHES_ACTIVE=10
MATCHES_STATE_BYTES=8192
MATCHES_RETAINED=100
MATCHES_PENDING_INVITES=20
MATCHES_SETTLEMENT=100
MATCHES_HISTORY_RETENTION_SECONDS=604800
MATCHES_RANKED_SETTLEMENT_SECONDS=604800

# Achievement quotas (positive integers; existing reads survive lower values).
ACHIEVEMENTS_DEFINITIONS=250
ACHIEVEMENTS_LIFETIME_KEYS=500

# Inbox operator defaults; retained valuable broadcasts keep their slots after lowering quotas.
INBOX_TARGETED=50
INBOX_BROADCASTS=500
INBOX_FREE_TEXTS=2
INBOX_FREE_TEXT_BYTES=256
INBOX_FREE_TEXT_RETENTION_DAYS=7

# Statistics definitions, positive Int32. Lowering keeps existing reads and replay.
STATISTICS_DEFINITIONS=100

# Shared Objects operator quotas. Defaults are editable; the1MiB decoded page is a wire bound.
SHARED_OBJECTS_COLLECTIONS=100
SHARED_OBJECTS_STORAGE_MIB=2048
SHARED_OBJECTS_OBJECT_KIB=64

# Groups operator policy; retained memberships/pending are never truncated after lowering.
GROUP_MEMBERS=500
GROUP_MEMBERSHIPS=5
GROUP_INVITATIONS=20
GROUP_JOIN_REQUESTS=20
GROUP_DATA_BYTES=2048
GROUP_MEMBER_PAGE_SIZE=50
GROUP_PLAYER_INVITATIONS=2
GROUP_PLAYER_REQUESTS=2
GROUP_NAME_BYTES=120
GROUP_DESCRIPTION_BYTES=1024
GROUP_DATA_DEPTH=16
